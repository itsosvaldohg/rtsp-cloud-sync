      "username": "cam_user",
      "password": "${CAM_PASS}",
      "rtsp_port": 554,
      "rtsp_stream": "stream2",
      "onvif_port": 2020,
      "recording_mode": "continuous",
      "segment_time_seconds": 900,
      "enabled": true
    },
    {
      "name": "entryway",
      "display_name": "Main Entryway",
      "model": "Tapo C110",
      "location": "interior",
      "mac": "AA:BB:CC:DD:EE:03",
      "ip": "192.168.1.103",
      "username": "cam_user",
      "password": "${CAM_PASS}",
      "rtsp_port": 554,
      "rtsp_stream": "stream2",
      "onvif_port": 2020,
