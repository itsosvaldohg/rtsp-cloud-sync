{
  "system": {
    "local_storage_base": "~/rtsp-cloud-sync/videos",
    "log_dir": "~/rtsp-cloud-sync/logs",
    "rclone_remote_base": "gdrive:SecurityVideos",
    "retention_days": 1,
    "sync_interval_seconds": 300,
    "min_free_disk_space_gb": 5.0,
    "max_storage_size_gb": 15.0
  },
  "cameras": [
    {
      "name": "front_yard",
      "display_name": "Front Yard",
      "model": "Tapo TC41",
      "location": "exterior",
      "mac": "AA:BB:CC:DD:EE:01",
      "ip": "192.168.1.101",
      "username": "cam_user",
      "password": "${CAM_PASS}",
      "rtsp_port": 554,
      "rtsp_stream": "stream2",
      "onvif_port": 2020,
      "recording_mode": "continuous",
      "segment_time_seconds": 900,
      "enabled": true
    },
    {
      "name": "back_yard",
      "display_name": "Back Yard",
      "model": "Tapo TC41",
      "location": "exterior",
      "mac": "AA:BB:CC:DD:EE:02",
